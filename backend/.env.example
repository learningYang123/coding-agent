# ===== 应用配置 =====
APP_NAME=企业代码智能助手
APP_VERSION=1.0.0
DEBUG=true

# ===== 数据库配置 =====
# 开发环境使用 SQLite，生产环境切换为 MySQL
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/code_assistant

# ===== JWT 配置 =====
SECRET_KEY=your-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM 配置 =====
# DeepSeek-Coder 兼容 OpenAI API
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-coder
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# 个人模型密钥加密：未指定时自动创建独立密钥文件，请随数据库备份
MODEL_ENCRYPTION_KEY=
MODEL_ENCRYPTION_KEY_FILE=./data/.model-key

# ===== Embedding 配置 =====
EMBEDDING_PROVIDER=local
# 本地模型路径（首次运行会自动下载）
EMBEDDING_MODEL_PATH=./data/embeddings/all-MiniLM-L6-v2
# 或使用在线接口
# EMBEDDING_PROVIDER=deepseek
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=text-embedding-v2

# ===== 向量库配置 =====
VECTOR_STORE=faiss
# VECTOR_STORE=milvus
FAISS_INDEX_PATH=./data/faiss
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ===== 代码沙箱配置 =====
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=256

# ===== Git 配置 =====
GIT_EXECUTABLE=git
GIT_CLONE_TIMEOUT=120
GIT_MAX_REPO_SIZE_MB=500

# ===== 代码分块配置 =====
CHUNK_MAX_SIZE=1500
CHUNK_OVERLAP=200
